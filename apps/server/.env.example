# Sunucu ortam değişkenleri (ortama verin; sunucu .env dosyasını kendisi okumaz).
# Hepsi isteğe bağlıdır.

PORT=3000
HOST=0.0.0.0
DATA_DIR=./.data

# Verilmezse ilk açılışta rastgele üretilip DATA_DIR/secrets.json içine yazılır.
# JWT_SECRET=
# ENCRYPTION_KEY=   # 64 haneli hex (openssl rand -hex 32)

# Panel başka bir origin'den sunulacaksa (virgülle ayırın)
# ALLOWED_ORIGINS=https://panel.ornek.com

# HTTPS ters vekil arkasında true yapın
SECURE_COOKIES=false
TRUST_PROXY=false

# İlk hesabı açtıktan sonra false yapabilirsiniz
ALLOW_REGISTRATION=true
